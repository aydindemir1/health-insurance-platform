{
  "realm": "health-insurance",
  "enabled": true,
  "displayName": "Health Insurance Platform",
  "roles": {
    "realm": [
      { "name": "HOSPITAL_USER", "description": "Submits and views provider requests" },
      { "name": "INSURANCE_SPECIALIST", "description": "Reviews and decides pre-authorization requests" },
      { "name": "CLAIM_APPROVER", "description": "Reviews and approves insurance claims" },
      { "name": "SYSTEM_ADMIN", "description": "Administers platform configuration and access" }
    ]
  },
  "clients": [
    {
      "clientId": "health-insurance-web",
      "name": "Health Insurance Web Application",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"]
    }
  ]
}
