# Copy this file to .env and replace every placeholder before starting Docker Compose.
KEYCLOAK_ADMIN_USERNAME=choose-a-local-admin-name
KEYCLOAK_ADMIN_PASSWORD=choose-a-strong-local-password
AUTHORIZATION_DB_USERNAME=choose-a-local-database-user
AUTHORIZATION_DB_PASSWORD=choose-a-strong-local-database-password
POLICY_DB_USERNAME=choose-a-local-policy-database-user
POLICY_DB_PASSWORD=choose-a-strong-local-policy-database-password
CLAIMS_BILLING_DB_USERNAME=choose-a-local-claims-database-user
CLAIMS_BILLING_DB_PASSWORD=choose-a-strong-local-claims-database-password
CORS_ALLOWED_ORIGINS=http://localhost:5173
